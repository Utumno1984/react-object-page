{
  "name": "react-object-page-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo root for react-object-page (open-core React design system).",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "tests/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "vitest run --config vitest.config.mjs",
    "test:unit": "npm run test --workspaces --if-present && npm run test:scripts",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:unit",
    "changeset": "changeset",
    "changeset:check": "node scripts/check-changeset.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs check",
    "bundle:update-baseline": "node scripts/bundle-budget.mjs update-baseline"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
